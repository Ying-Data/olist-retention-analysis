venv/
.venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDEs
.vscode/
.idea/

# Excel lock files
~$*.xlsx
~$*.xls
