# Secrets and environment
.env
.env.*

# Raw Kaggle source files (download from the dataset link in the README).
# All CSVs are ignored, then the processed exports are re-included explicitly.
*.csv
!data/olist_powerbi_export.csv
!data/feature_importance.csv

# Spreadsheets are ignored, except the delivered executive workbook.
*.xlsx
!output/olist_executive_workbook.xlsx

# Python cache and bytecode
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDEs
.vscode/
.idea/

# Logs
*.log

# Node (for any tooling that pulls it in)
node_modules/

# Excel lock files
~$*.xlsx
~$*.xls
